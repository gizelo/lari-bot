{
  "name": "lari-bot",
  "version": "1.0.0",
  "description": "Telegram-бот учёта совместных расходов (GEL)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "setwebhook": "tsx scripts/set-webhook.ts",
    "delwebhook": "tsx scripts/delete-webhook.ts"
  },
  "packageManager": "pnpm@11.0.8",
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.45.1",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vercel/node": "^5.9.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
