# Токен бота: BotFather -> /newbot
TELEGRAM_BOT_TOKEN=

# Любая случайная строка 32+ символа. Сверяется с заголовком X-Telegram-Bot-Api-Secret-Token.
# Нужна только для вебхука (прод); для локального long polling можно оставить пустой.
TELEGRAM_WEBHOOK_SECRET=

# Supabase -> Project Settings -> Database -> Connection string (Transaction pooler, порт 6543)
DATABASE_URL=

# Секрет для ежемесячной автосводки (Vercel Cron шлёт его как Bearer). Случайная строка.
CRON_SECRET=

# Опционально, есть дефолты
TZ=Asia/Tbilisi
DEFAULT_CURRENCY=GEL
CURRENCY_SYMBOL=₾
