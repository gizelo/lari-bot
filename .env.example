# Bot token: BotFather -> /newbot
TELEGRAM_BOT_TOKEN=

# Any random string of at least 32 characters. Compared with X-Telegram-Bot-Api-Secret-Token.
# Required only for the production webhook; it can remain empty for local long polling.
TELEGRAM_WEBHOOK_SECRET=

# Neon -> Connect -> Connection pooling enabled. Keep sslmode=require.
DATABASE_URL=

# Neon direct connection, with pooling disabled. Used for schema migrations.
DATABASE_URL_UNPOOLED=

# Secret for the monthly summary. Vercel Cron sends it as a Bearer token. Use 32+ random characters.
CRON_SECRET=

# Optional; defaults are provided
TZ=Asia/Tbilisi
DEFAULT_CURRENCY=GEL
CURRENCY_SYMBOL=₾
